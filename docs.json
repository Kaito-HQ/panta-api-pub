{
  "$schema": "https://mintlify.com/docs.json",
  "theme": "mint",
  "name": "Panta API",
  "description": "Public API for Panta USDC prediction markets on Solana. Quote, build unsigned transactions, and attribute trades \u2014 without holding user keys.",
  "colors": {
    "primary": "#0A0A0A",
    "light": "#3F3F46",
    "dark": "#FAFAFA"
  },
  "favicon": "/favicon.svg",
  "logo": {
    "light": "/logo/light.svg",
    "dark": "/logo/dark.svg"
  },
  "navbar": {
    "links": [
      {
        "label": "panta.market",
        "href": "https://panta.market"
      },
      {
        "label": "Terms",
        "href": "/guides/terms-of-use"
      }
    ]
  },
  "footer": {
    "socials": {
      "website": "https://panta.market"
    }
  },
  "api": {
    "playground": {
      "display": "interactive",
      "proxy": true
    },
    "url": "full",
    "examples": {
      "languages": [
        "curl",
        "javascript",
        "python"
      ],
      "defaults": "required",
      "autogenerate": true
    },
    "mdx": {
      "server": "https://live-api.panta.market/api/v1",
      "auth": {
        "method": "none",
        "name": "X-Api-Key"
      }
    }
  },
  "navigation": {
    "tabs": [
      {
        "tab": "Guides",
        "groups": [
          {
            "group": "Get started",
            "pages": [
              "index",
              "quickstart",
              "guides/how-it-works"
            ]
          },
          {
            "group": "Platform",
            "pages": [
              "guides/authentication",
              "guides/errors",
              "guides/terms-of-use"
            ]
          }
        ]
      },
      {
        "tab": "API reference",
        "groups": [
          {
            "group": "Auth",
            "pages": [
              "api-reference/auth/register",
              "api-reference/auth/token",
              "api-reference/auth/refresh"
            ]
          },
          {
            "group": "Account",
            "pages": [
              "api-reference/account/get",
              "api-reference/account/update",
              "api-reference/account/dashboard",
              "api-reference/account/metrics",
              "api-reference/account/creates",
              "api-reference/account/trades",
              "api-reference/account/list-keys",
              "api-reference/account/create-key",
              "api-reference/account/revoke-key"
            ]
          },
          {
            "group": "Markets catalog",
            "pages": [
              "api-reference/markets/catalog",
              "api-reference/markets/list",
              "api-reference/markets/get",
              "api-reference/markets/trades",
              "api-reference/markets/categories",
              "api-reference/markets/wallet-trades"
            ]
          },
          {
            "group": "Create market",
            "pages": [
              "api-reference/markets/overview",
              "api-reference/markets/image-upload",
              "api-reference/markets/quote",
              "api-reference/markets/build",
              "api-reference/markets/register"
            ]
          },
          {
            "group": "Primary buy",
            "pages": [
              "api-reference/orders/overview",
              "api-reference/orders/quote",
              "api-reference/orders/build",
              "api-reference/orders/submit",
              "api-reference/orders/verify"
            ]
          },
          {
            "group": "Positions and claims",
            "pages": [
              "api-reference/positions",
              "api-reference/claims/build"
            ]
          },
          {
            "group": "Trades",
            "pages": [
              "api-reference/trades/report",
              "api-reference/trades/status"
            ]
          }
        ]
      }
    ]
  },
  "contextual": {
    "options": [
      "copy",
      "view",
      "chatgpt",
      "claude",
      "cursor"
    ]
  }
}
